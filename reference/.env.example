# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored, `.env.example` is committed as a template.

# OpenAI key — used by the previous team's Step 1 artifacts (LLM metadata
# extraction, GraphRAG community summarisation). Not required to run our
# reproduced baseline or the Step 3 agentic system.
OPENAI_API_KEY=sk-replace-me

# Anthropic key — used by the Step 3 reliable & adaptive agentic system
# (answer generation, verification/critique, query rewriting, query profiling).
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional model overrides for the agentic system. Defaults shown.
#   AGENT_MODEL_GENERATION=claude-opus-4-7
#   AGENT_MODEL_VERIFIER=claude-opus-4-7
#   AGENT_MODEL_UTILITY=claude-haiku-4-5

# Root of the local baseline data tree. The notebooks resolve all paths
# relative to this. Adjust if you flatten the extracted folders or move
# them outside the repo.
BASELINE_ROOT=C:/Users/Gebruiker/PycharmProjects/Adv.-Gen-AI/Baseline
